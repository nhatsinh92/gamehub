{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "*.js",
    ".storybook",
    "src",
    "../sky-hopper/src",
    "../scratch-card-example/src"
  ]
}
